{
  "id": "internal-consistency",
  "name": "Cart aggregates agree with visible line items",
  "description": "Two products, then a quantity change. Every rule here works from what the page displays, including the price-free rule that compares the total against the sum of the visible line totals.",
  "target": { "kind": "local_demo" },
  "steps": [
    { "action": "open", "label": "Load the shop" },
    { "action": "click", "target": "add-trail-mug", "label": "Add Trail Mug" },
    { "action": "click", "target": "add-field-notebook", "label": "Add Field Notebook" },
    {
      "action": "change_quantity",
      "target": "quantity-trail-mug",
      "value": "3",
      "label": "Set Trail Mug quantity to 3"
    }
  ],
  "capture": ["total", "subtotal", "checkout-total"],
  "invariants": [
    { "rule": "total_equals_sum_of_line_totals" },
    { "rule": "line_total_matches_price_x_qty" },
    { "rule": "subtotal_equals_total" },
    { "rule": "checkout_total_equals_total" }
  ]
}
