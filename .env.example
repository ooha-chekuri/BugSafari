# BugSafari configuration.
#
# Every value is optional. The defaults run the bundled demo offline and require
# no API key. Copy this file to `.env` only if you want to override something;
# `.env` is gitignored and never read automatically by the application.

# Target URL. Leave empty to start the bundled Flask demo on an ephemeral port.
# BUGSAFARI_TARGET_URL=http://127.0.0.1:5000

# Bundled demo server (used when no target URL is configured).
BUGSAFARI_DEMO_HOST=127.0.0.1
# 0 means "pick a free port". The standalone `python -m demo_app.app` uses 5000.
BUGSAFARI_DEMO_PORT=0

# Browser and execution limits.
BUGSAFARI_HEADLESS=true
# Optional: chrome | msedge | chromium. Empty tries bundled Chromium first,
# then falls back to an installed Chrome or Edge.
# BUGSAFARI_BROWSER_CHANNEL=
BUGSAFARI_ACTION_TIMEOUT_MS=5000
BUGSAFARI_RUN_TIMEOUT_S=120

# Where screenshots and run reports are written.
BUGSAFARI_ARTIFACT_DIR=artifacts
BUGSAFARI_RUNS_DIR=.bugsafari/runs

# Planner: scripted (default, deterministic) | seeded_random | llm.
# The llm planner is optional and falls back to scripted when unavailable.
BUGSAFARI_PLANNER=scripted
BUGSAFARI_SEED=0
# BUGSAFARI_LLM_ENDPOINT=
# BUGSAFARI_LLM_API_KEY=
